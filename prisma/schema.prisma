  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout          Workout? @relation(fields: [workoutId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([date])
}

model BodyMeasurementEntry {
  id            String   @id @default(uuid())
  userId        String
  recordedAt    DateTime
  metricKey     String
  displayName   String?
  value         Float
  unit          String
  source        String
  sourceRefType String?
  sourceRefId   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDuplicate   Boolean  @default(false)
  customMetrics Json?    @default("{}")
  isDeleted     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metricKey, recordedAt(sort: Desc)])
  @@index([userId, recordedAt(sort: Desc)])
}

model PersonalBest {
  id        String   @id @default(uuid())
  userId    String
  type      String
  category  String
  value     Float
  unit      String
  date      DateTime
  workoutId String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout? @relation(fields: [workoutId], references: [id])

  @@unique([userId, type])
  @@index([userId])
  @@index([category])
}

model Team {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  ownerId       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groups        AthleteGroup[]
  owner         User           @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  invites       TeamInvite[]
  members       TeamMember[]
  trainingPlans TrainingPlan[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(ATHLETE)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model AthleteGroup {
  id          String               @id @default(uuid())
  name        String
  description String?
  coachId     String
  teamId      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  coach       User                 @relation("CoachGroups", fields: [coachId], references: [id], onDelete: Cascade)
  team        Team?                @relation(fields: [teamId], references: [id])
  members     AthleteGroupMember[]
  invites     TeamInvite[]

  @@index([coachId])
  @@index([teamId])
}

model AthleteGroupMember {
  id        String       @id @default(uuid())
  groupId   String
  athleteId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  athlete   User         @relation("AthleteGroupMemberships", fields: [athleteId], references: [id], onDelete: Cascade)
  group     AthleteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, athleteId])
  @@index([groupId])
  @@index([athleteId])
}

model TeamInvite {
  id        String        @id @default(uuid())
  teamId    String
  email     String?
  role      TeamRole      @default(ATHLETE)
  code      String        @unique
  status    String        @default("PENDING")
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  groupId   String?
  group     AthleteGroup? @relation(fields: [groupId], references: [id])
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([code])
}

model CustomFieldDefinition {
  id         String   @id @default(uuid())
  ownerId    String
  entityType String
  fieldKey   String
  label      String
  dataType   String
  unit       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, entityType, fieldKey])
  @@index([ownerId])
}

model Dashboard {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Int      @default(0)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  widgets   Widget[]

  @@index([ownerId])
  @@index([ownerId, order])
}

model Widget {
  id          String     @id @default(uuid())
  ownerId     String
  dashboardId String?
  name        String
  config      Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dashboard   Dashboard? @relation(fields: [dashboardId], references: [id])
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([dashboardId])
}

model TrainingPlanFolder {
  id        String               @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  order     Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  plans     TrainingPlan[]
  parent    TrainingPlanFolder?  @relation("TrainingPlanFolderHierarchy", fields: [parentId], references: [id])
  children  TrainingPlanFolder[] @relation("TrainingPlanFolderHierarchy")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
}

model FavoriteTrainingPlan {
  id        String       @id @default(uuid())
  userId    String
  planId    String
  createdAt DateTime     @default(now())
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model CheckIn {
  id                 String          @id @default(uuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  userId             String
  personalChallenges String?
  personalGoals      String?
  personalHighlights String?
  personalNotes      String?
  wellnessInjury     String?
  wellnessPain       String?
  personalFatigue    Int?
  trainingDifficulty Int?
  trainingHydration  Int?
  trainingLoad       Int?
  trainingNutrition  Int?
  trainingRecovery   Int?
  wellnessSleep      Int?
  wellnessStress     Int?
  wellnessPainScore  Int?            @default(1)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks          CoachFeedback[]

  @@index([userId])
}

model CoachFeedback {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  checkInId  String?
  komodoUrl  String?
  coachNotes String?
  checkIn    CheckIn? @relation(fields: [checkInId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkInId])
}

model ScheduledTaskConfig {
  id             String    @id @default(cuid())
  taskName       String    @unique
  displayName    String
  cronExpression String
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  lastStatus     String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

