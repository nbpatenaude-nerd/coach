model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model WeeklyCheckIn {
  id            String   @id @default(cuid())
  athleteId     String
  coachId       String?
  weekStartDate DateTime // The Sunday that starts this week
  submittedAt   DateTime @default(now())

  // Basic check-in data
  feelingScore Int? // 1-10
  fatigueScore Int? // 1-10
  stressScore  Int? // 1-10
  sleepQuality Int? // 1-10

  notes           String?   @db.Text
  coachFeedback   String?   @db.Text
  coachReviewedAt DateTime?

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, weekStartDate])
  @@index([athleteId])
  @@index([coachId])
}
