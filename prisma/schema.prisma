generator client {
  provider        = "prisma-client"
  output          = "../server/utils/generated-prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String             @id @default(uuid())
  name                               String?
  email                              String             @unique
  emailVerified                      DateTime?
  image                              String?
  hashedPassword                     String?
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt
  ftp                                Int?
  maxHr                              Int?
  weight                             Float?
  dob                                DateTime?
  currentFitnessScore                Int?
  recoveryCapacityScore              Int?
  nutritionComplianceScore           Int?
  trainingConsistencyScore           Int?
  profileLastUpdated                 DateTime?
  currentFitnessExplanation          String?
  recoveryCapacityExplanation        String?
  nutritionComplianceExplanation     String?
  trainingConsistencyExplanation     String?
  currentFitnessExplanationJson      Json?
  recoveryCapacityExplanationJson    Json?
  nutritionComplianceExplanationJson Json?
  trainingConsistencyExplanationJson Json?
  trackedCheckinMetrics              String[]           @default(["bloodGlucose"])
  aiAutoAnalyzeNutrition             Boolean            @default(false)
  aiAutoAnalyzeWorkouts              Boolean            @default(false)
  aiModelPreference                  String?            @default("flash")
  aiPersona                          String?            @default("Supportive")
  city                               String?
  country                            String?
  distanceUnits                      String?            @default("Kilometers")
  form                               String?            @default("Absolute value")
  height                             Int?
  heightUnits                        String?            @default("cm")
  hrZones                            Json?
  language                           String?            @default("English")
  powerZones                         Json?
  restingHr                          Int?
  sex                                String?
  state                              String?
  temperatureUnits                   String?            @default("Celsius")
  timezone                           String?
  visibility                         String?            @default("Private")
  weightUnits                        String?            @default("Kilograms")
  altitude                           Int?
  isAdmin                            Boolean            @default(false)
  isCoach                            Boolean            @default(false)
  lthr                               Int?
  healthConsentAcceptedAt            DateTime?
  privacyPolicyVersion               String?
  termsAcceptedAt                    DateTime?
  termsVersion                       String?
  hrPowerAlignmentExplanation        String?
  hrPowerAlignmentExplanationJson    Json?
  hrPowerAlignmentScore              Int?
  aiContext                          String?
  nickname                           String?
  nutritionTrackingEnabled           Boolean            @default(true)
  recoverySensitivity                String?            @default("MEDIUM")
  stripeCustomerId                   String?            @unique
  stripeSubscriptionId               String?            @unique
  subscriptionPeriodEnd              DateTime?
  subscriptionStatus                 SubscriptionStatus @default(NONE)
  subscriptionTier                   SubscriptionTier   @default(FREE)
  aiDeepAnalysisEnabled              Boolean            @default(false)
  aiProactivityEnabled               Boolean            @default(false)
  aiAutoAnalyzeReadiness             Boolean            @default(false)
  dashboardSettings                  Json?
  lastLoginAt                        DateTime?
  lastLoginIp                        String?
  registrationCountry                String?
  registrationIp                     String?
  aiRequireToolApproval              Boolean            @default(false)
  subscriptionStartedAt              DateTime?
  updateWorkoutNotesEnabled          Boolean            @default(true)
  trialEndsAt                        DateTime?
  pendingSubscriptionPeriodEnd       DateTime?
  pendingSubscriptionTier            SubscriptionTier?
  aiConversationalEngagement         Boolean            @default(true)
  shareRewardClaimedAt               DateTime?
  shareRewardDaysGranted             Int?               @default(0)
  aiTtsStyle                         String?            @default("coach")
  aiTtsVoiceName                     String?            @default("Kore")
  aiTtsSpeed                         String?            @default("normal")
  aiTtsAutoReadMessages              Boolean            @default(false)
  emailError                         String?
  emailStatus                        String             @default("VALID")

  // System Flags
  hasDashboardAccess             Boolean                         @default(true)
  weightSourceMode               String                          @default("AUTO")
  uiLanguage                     String?                         @default("en")
  aiMemoryEnabled                Boolean                         @default(false)
  aiWorkoutAutonomyLimit         Int                             @default(10)
  publicAuthorSlug               String?                         @unique
  publicDisplayName              String?
  publicBio                      String?
  publicLocation                 String?
  publicWebsiteUrl               String?
  publicSocialLinks              Json?
  publicCoachingBrand            String?
  personalBestsBackfilledAt      DateTime?
  teamVisibility                 TeamVisibility?                 @default(COACHES_ONLY)
  featureFlags                   Json?
  coachProfileEnabled            Boolean                         @default(false)
  coachProfileSlug               String?                         @unique
  coachPublicPage                Json?
  athleteProfileEnabled          Boolean                         @default(false)
  athleteProfileSlug             String?                         @unique
  athletePublicPage              Json?
  deactivatedAt                  DateTime?
  deactivationReason             String?
  referralCode                   String?                         @unique
  referredByUserId               String?
  role                           Role                            @default(FREE)
  intervalsApiKey                String?
  intervalsAthleteId             String?
  accounts                       Account[]
  activityRecommendations        ActivityRecommendation[]
  apiKeys                        ApiKey[]
  athleteGroups                  AthleteGroup[]                  @relation("CoachGroups")
  groupMemberships               AthleteGroupMember[]            @relation("AthleteGroupMemberships")
  journeyEvents                  AthleteJourneyEvent[]
  auditLogs                      AuditLog[]
  bodyMeasurementEntries         BodyMeasurementEntry[]
  bugReports                     BugReport[]
  bugReportComments              BugReportComment[]
  calendarNotes                  CalendarNote[]
  chatParticipations             ChatParticipant[]
  chatTurns                      ChatTurn[]
  checkIns                       CheckIn[]
  weeklyCheckIns                 WeeklyCheckIn[]
  coachAthleteInvitesSent        CoachAthleteInvite[]
  feedbacks                      CoachFeedback[]
  invites                        CoachingInvite[]
  coaches                        CoachingRelationship[]          @relation("AthleteRelation")
  athletes                       CoachingRelationship[]          @relation("CoachRelation")
  coachingRequestsSent           CoachingRequest[]               @relation("AthleteRequestsSent")
  coachingRequestsReceived       CoachingRequest[]               @relation("CoachRequestsReceived")
  customFieldDefinitions         CustomFieldDefinition[]
  dailyCheckins                  DailyCheckin[]
  dailyMetrics                   DailyMetric[]
  dashboards                     Dashboard[]
  emailDeliveries                EmailDelivery[]
  emailPreferences               EmailPreference[]
  events                         Event[]
  favoriteTrainingPlans          FavoriteTrainingPlan[]
  fitFiles                       FitFile[]
  goals                          Goal[]
  integrations                   Integration[]
  llmUsage                       LlmUsage[]
  mcpToolExecutions              McpToolExecution[]
  metricHistory                  MetricHistory[]
  mobilePushDevices              MobilePushDevice[]
  mobilePushPreference           MobilePushPreference?
  nutrition                      Nutrition[]
  nutritionPlans                 NutritionPlan[]
  nutritionRecommendations       NutritionRecommendation[]
  oauthApps                      OAuthApp[]
  oauthCodes                     OAuthAuthCode[]
  oauthConsents                  OAuthConsent[]
  oauthTokens                    OAuthToken[]
  partnerCampaignRedemptions     PartnerCampaignRedemption[]
  personalBests                  PersonalBest[]
  plannedWorkouts                PlannedWorkout[]
  providerSubscriptions          ProviderSubscription[]
  quotaDenials                   QuotaDenial[]
  recommendations                Recommendation[]
  referralAsReferee              Referral?                       @relation("ReferralReferee")
  referralsAsReferrer            Referral[]                      @relation("ReferralReferrer")
  reports                        Report[]
  reportTemplates                ReportTemplate[]
  scoreTrendExplanations         ScoreTrendExplanation[]
  sessions                       Session[]
  shareTokens                    ShareToken[]
  sportSettings                  SportSettings[]
  strengthExerciseLibraryItems   StrengthExerciseLibraryItem[]
  subscriptionLifecycleEvents    SubscriptionLifecycleEvent[]
  supportMessages                SupportMessage[]
  syncQueue                      SyncQueue[]
  ownedTeams                     Team[]                          @relation("TeamOwner")
  teamMemberships                TeamMember[]
  trainingAvailability           TrainingAvailability[]
  trainingPlans                  TrainingPlan[]
  trainingPlanFolders            TrainingPlanFolder[]
  referredBy                     User?                           @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referralsGiven                 User[]                          @relation("UserReferrals")
  memories                       UserMemory[]
  notifications                  UserNotification[]
  nutritionSettings              UserNutritionSettings?
  systemMessageDismissals        UserSystemMessageDismissal[]
  weeklyTrainingPlans            WeeklyTrainingPlan[]
  wellness                       Wellness[]
  widgets                        Widget[]
  workouts                       Workout[]
  workoutStructureGenerationRuns WorkoutStructureGenerationRun[]
  workoutTemplates               WorkoutTemplate[]
  workoutTemplateFolders         WorkoutTemplateFolder[]
  eventParticipants              EventParticipant[]

  // CRM Fields
  pipelineStage String?     @default("Lead") // Deprecated: Migrating to CrmDeal
  driveFolderId String?
  crmTags       String[]    @default([])
  coachNotes    CoachNote[]
  crmDeals      CrmDeal[]   @relation("UserDeals")
  crmTasks      CrmTask[]   @relation("UserTasks")
  crmEmailDrafts CrmEmailDraft[] @relation("UserEmailDrafts")
  leadSource    String?
  churnRisk     String?     @default("LOW")
  lifetimeValue Float?      @default(0)

  @@index([createdAt])
  @@index([deactivatedAt])
  @@index([subscriptionTier])
  @@index([referredByUserId])
}

model Referral {
  id             String         @id @default(uuid())
  referrerUserId String
  refereeUserId  String         @unique
  code           String
  source         String         @default("link")
  status         ReferralStatus @default(ATTRIBUTED)
  attributedAt   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  referee        User           @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  referrer       User           @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([code])
  @@index([status])
}

model CoachNote {
  id          String   @id @default(uuid())
  userId      String
  text        String
  isAiSummary Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CrmPipeline {
  id          String             @id @default(uuid())
  name        String
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  stages      CrmPipelineStage[]
  deals       CrmDeal[]
}

model CrmPipelineStage {
  id         String      @id @default(uuid())
  pipelineId String
  name       String
  order      Int
  color      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      CrmDeal[]

  @@index([pipelineId])
}

model CrmDeal {
  id         String           @id @default(uuid())
  userId     String
  pipelineId String
  stageId    String
  name       String?
  value      Float?
  status     String           @default("OPEN")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation("UserDeals", fields: [userId], references: [id], onDelete: Cascade)
  pipeline   CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks      CrmTask[]

  @@index([userId])
  @@index([pipelineId])
  @@index([stageId])
}

model CrmTask {
  id          String    @id @default(uuid())
  dealId      String?
  userId      String?
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deal        CrmDeal?  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User?     @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([userId])
}

model CrmEmailDraft {
  id          String    @id @default(uuid())
  userId      String
  subject     String
  body        String    @db.Text
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, SENT
  promptId    String?   // Optional reference to which prompt generated this
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("UserEmailDrafts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SportSettings {
  id                  String   @id @default(cuid())
  userId              String
  types               String[]
  ftp                 Int?
  indoorFtp           Int?
  wPrime              Int?
  powerZones          Json?
  lthr                Int?
  maxHr               Int?
  hrZones             Json?
  thresholdPace       Float?
  paceZones           Json?
  source              String   @default("intervals")
  externalId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cooldownTime        Int?
  eFtp                Int?
  ePMax               Int?
  eWPrime             Int?
  eftpMinDuration     Int?
  hrLoadType          String?
  loadPreference      String?
  pMax                Int?
  powerSpikeThreshold Int?
  restingHr           Int?
  warmupTime          Int?
  zoneConfiguration   Json?
  name                String?
  isDefault           Boolean  @default(false)
  targetPolicy        Json?
  targetFormatPolicy  Json?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId])
}

model SystemMessage {
  id             String                       @id @default(uuid())
  title          String
  content        String
  type           String                       @default("INFO")
  isActive       Boolean                      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  actionLabel    String?
  targetUrl      String?
  minUserAgeDays Int                          @default(0)
  dismissals     UserSystemMessageDismissal[]
}

model UserSystemMessageDismissal {
  id              String        @id @default(uuid())
  userId          String
  systemMessageId String
  dismissedAt     DateTime      @default(now())
  systemMessage   SystemMessage @relation(fields: [systemMessageId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, systemMessageId])
  @@index([userId])
}

model OAuthApp {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  homepageUrl        String?
  logoUrl            String?
  clientId           String              @unique @default(dbgenerated("gen_random_uuid()"))
  clientSecret       String
  redirectUris       String[]
  isTrusted          Boolean             @default(false)
  isPublic           Boolean             @default(false)
  ownerId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  webhookSecret      String?
  sourceName         String?
  isPublicClient     Boolean             @default(false)
  registrationType   String              @default("manual")
  isOfficial         Boolean             @default(false)
  mcpIdempotencyKeys McpIdempotencyKey[]
  mcpToolExecutions  McpToolExecution[]
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  codes              OAuthAuthCode[]
  consents           OAuthConsent[]
  tokens             OAuthToken[]
  workouts           Workout[]           @relation("WorkoutOAuthApp")

  @@index([ownerId])
}

model OAuthConsent {
  id        String   @id @default(uuid())
  userId    String
  appId     String
  scopes    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  app       OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
}

model OAuthAuthCode {
  code                String   @id @unique
  appId               String
  userId              String
  redirectUri         String
  scopes              String[]
  codeChallenge       String?
  codeChallengeMethod String?  @default("S256")
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  resource            String?
  app                 OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id                    String              @id @default(uuid())
  accessToken           String              @unique
  refreshToken          String?             @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  appId                 String
  userId                String
  scopes                String[]
  createdAt             DateTime            @default(now())
  lastUsedAt            DateTime?
  lastIp                String?
  resource              String?
  refreshTokenRotatedAt DateTime?
  mcpIdempotencyKeys    McpIdempotencyKey[]
  mcpToolExecutions     McpToolExecution[]
  app                   OAuthApp            @relation(fields: [appId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessToken])
  @@index([refreshToken])
}

model McpToolExecution {
  id          String      @id @default(uuid())
  userId      String
  appId       String
  tokenId     String?
  requestId   String
  toolName    String
  argsHash    String
  status      String
  errorCode   String?
  durationMs  Int?
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  app         OAuthApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  token       OAuthToken? @relation(fields: [tokenId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([appId, createdAt])
  @@index([requestId])
}

model McpIdempotencyKey {
  id             String     @id @default(uuid())
  appId          String
  tokenId        String
  toolName       String
  idempotencyKey String
  status         String
  responseHash   String?
  createdAt      DateTime   @default(now())
  expiresAt      DateTime
  app            OAuthApp   @relation(fields: [appId], references: [id], onDelete: Cascade)
  token          OAuthToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([appId, tokenId, toolName, idempotencyKey])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ShareToken {
  id           String    @id @default(uuid())
  userId       String
  resourceType String
  resourceId   String
  token        String    @unique @default(dbgenerated("gen_random_uuid()"))
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accessMode   String?   @default("PREVIEW")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([resourceType, resourceId])
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  key        String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model CoachingRelationship {
  id          String   @id @default(uuid())
  coachId     String
  athleteId   String
  status      String   @default("ACTIVE")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  athlete     User     @relation("AthleteRelation", fields: [athleteId], references: [id], onDelete: Cascade)
  coach       User     @relation("CoachRelation", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
}

model CoachingInvite {
  id        String   @id @default(uuid())
  athleteId String
  code      String   @unique
  expiresAt DateTime
  usedBy    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([code])
}

model CoachAthleteInvite {
  id         String   @id @default(uuid())
  coachId    String
  email      String?
  code       String   @unique
  status     String   @default("PENDING")
  expiresAt  DateTime
  acceptedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  coach      User     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([email])
  @@index([code])
}

model CoachingRequest {
  id              String    @id @default(uuid())
  coachId         String
  athleteId       String
  status          String    @default("PENDING")
  source          String    @default("coachStartPage")
  answers         Json?
  athleteSnapshot Json?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  athlete         User      @relation("AthleteRequestsSent", fields: [athleteId], references: [id], onDelete: Cascade)
  coach           User      @relation("CoachRequestsReceived", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId], map: "CoachingRequest_pending_unique_idx", where: raw("(status = 'PENDING'::text)"))
  @@index([coachId, status])
  @@index([athleteId, status])
}

model Goal {
  id            String         @id @default(uuid())
  userId        String
  type          String
  title         String
  description   String?
  metric        String?
  currentValue  Float?
  targetValue   Float?
  startValue    Float?
  targetDate    DateTime?
  eventDate     DateTime?
  eventType     String?
  status        String         @default("ACTIVE")
  priority      String         @default("MEDIUM")
  aiContext     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  distance      Float?
  duration      Float?
  elevation     Int?
  phase         String?
  terrain       String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlans TrainingPlan[]
  events        Event[]        @relation("EventToGoal")

  @@index([userId])
}

model Event {
  id               String   @id @default(uuid())
  userId           String
  externalId       String?
  source           String?
  title            String
  description      String?
  date             DateTime
  type             String?
  subType          String?
  distance         Float?
  elevation        Int?
  expectedDuration Float?
  terrain          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  city             String?
  country          String?
  isPublic         Boolean  @default(false)
  isVirtual        Boolean  @default(false)
  location         String?
  priority         String?  @default("B")
  websiteUrl       String?
  startTime        String?
  syncError        String?
  syncStatus       String?  @default("SYNCED")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants     EventParticipant[]
  goals            Goal[]   @relation("EventToGoal")

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([date])
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  priority  String?  @default("B")
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Integration {
  id                   String    @id @default(uuid())
  userId               String
  provider             String
  accessToken          String
  refreshToken         String?
  expiresAt            DateTime?
  externalUserId       String?
  scope                String?
  lastSyncAt           DateTime?
  syncStatus           String?
  errorMessage         String?
  initialSyncCompleted Boolean?  @default(false)
  ingestWorkouts       Boolean   @default(false)
  settings             Json?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalUserId])
}

model Workout {
  id                              String            @id @default(uuid())
  userId                          String
  externalId                      String
  source                          String
  date                            DateTime
